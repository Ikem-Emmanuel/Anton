{
  "name": "anton-service",
  "version": "1.0.0",
  "private": true,
  "description": "Anton — Personal AI operating system powered by Claude Agent SDK",
  "type": "module",
  "exports": "./index.js",
  "scripts": {
    "start": "node --import tsx index.js",
    "dev": "node --import tsx --watch index.js",
    "test": "vitest run --reporter=verbose",
    "test:watch": "vitest",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{js,json}": "biome check --write --no-errors-on-unmatched"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.2.101",
    "@slack/bolt": "3.22.0",
    "better-sqlite3": "^12.9.0",
    "ioredis": "^5.10.1",
    "ollama": "^0.6.3",
    "opossum": "^9.0.0",
    "systeminformation": "^5.31.5",
    "ws": "^8.20.0",
    "zod": "^4.3.6"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.0.0",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^25.6.0",
    "@types/opossum": "^8.1.9",
    "husky": "^9.0.0",
    "lint-staged": "^15.0.0",
    "tsx": "^4.21.0",
    "typescript": "^6.0.2",
    "vitest": "^4.1.4"
  }
}
