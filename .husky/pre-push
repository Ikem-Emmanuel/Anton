#!/bin/bash
# Anton — Pre-push Hook
# Scans commits being pushed for AI attribution in messages and staged content

set -e

RED='\033[0;31m'
YELLOW='\033[1;33m'
GREEN='\033[0;32m'
NC='\033[0m'

AI_PATTERN='(generated (by|with) (claude|copilot|chatgpt|gpt-4|openai)|co-authored-by:.*(claude|copilot|chatgpt)|ai[- ]assisted|llm[- ]generated)'

# Pre-existing commits grandfathered through before the AI-attribution policy
# was added. Rewriting these would re-SHA the entire history downstream. New
# commits still have to be clean — the hook only tolerates these exact SHAs.
ALLOWED_COMMITS=(
    "428465c013b48162813af55af3aac299ee15c46e"  # Initial commit
    "df0d3fb5852216615ad8ff272ce8df0943bc37e7"  # Add JARVIS upgrade master TODO
    "db4523a99b535ce00300611184ca8ebad5c17d7b"  # Restructure project: flatten service/
    "edc2082c6b6d6555b16b4c12305c6f33b40b4e5f"  # Clean up: remove old directories
)

is_allowed() {
    local sha="$1"
    for allowed in "${ALLOWED_COMMITS[@]}"; do
        if [ "$sha" = "$allowed" ]; then
            return 0
        fi
    done
    return 1
}

echo "Scanning pushed commits for AI attribution..."

# Git null ref (new/deleted branch sentinel)
NULL_REF=$(printf '%0.s0' {1..40})

VIOLATIONS=0

while read -r local_ref local_sha remote_ref remote_sha; do
    # Skip branch deletions
    if [ "$local_sha" = "$NULL_REF" ]; then
        continue
    fi

    # Determine range of commits being pushed
    if [ "$remote_sha" = "$NULL_REF" ]; then
        # New branch — check only commits not already on any remote tracking branch
        commits=$(git log --format="%H" "${local_sha}" --not --remotes 2>/dev/null || true)
    else
        range="${remote_sha}..${local_sha}"
        commits=$(git log --format="%H" "${range}" 2>/dev/null || true)
    fi

    for commit in $commits; do
        if is_allowed "$commit"; then
            continue
        fi

        commit_msg=$(git log --format="%B" -n 1 "$commit")

        if echo "$commit_msg" | grep -qiE "$AI_PATTERN"; then
            printf "${RED}AI attribution found in commit ${commit:0:8}:${NC}\n"
            echo "$commit_msg" | grep -iE "$AI_PATTERN" | head -3
            VIOLATIONS=$((VIOLATIONS + 1))
        fi
    done
done

if [ $VIOLATIONS -gt 0 ]; then
    echo ""
    printf "${RED}PUSH BLOCKED - AI ATTRIBUTION IN COMMIT HISTORY${NC}\n"
    echo ""
    printf "${YELLOW}Amend the offending commits to remove AI tool references.${NC}\n"
    echo ""
    exit 1
fi

printf "${GREEN}No AI attribution found in commits being pushed${NC}\n"
exit 0
