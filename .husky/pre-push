#!/bin/bash
# Anton — Pre-push Hook
# Scans commits being pushed for AI attribution in messages and staged content

set -e

RED='\033[0;31m'
YELLOW='\033[1;33m'
GREEN='\033[0;32m'
NC='\033[0m'

AI_PATTERN='(generated (by|with) (claude|copilot|chatgpt|gpt-4|openai)|co-authored-by:.*(claude|copilot|chatgpt)|🤖 generated|ai[- ]assisted|llm[- ]generated)'

echo "🤖 Scanning pushed commits for AI attribution..."

# Read the commits being pushed from stdin: <local_ref> <local_sha> <remote_ref> <remote_sha>
VIOLATIONS=0

while read -r local_ref local_sha remote_ref remote_sha; do
    # Skip branch deletions
    if [ "$local_sha" = "0000000000000000000000000000000000000000" ]; then
        continue
    fi

    # Determine range of commits being pushed
    if [ "$remote_sha" = "0000000000000000000000000000000000000000" ]; then
        # New branch — check only commits not already on any remote tracking branch
        commits=$(git log --format="%H" "${local_sha}" --not --remotes 2>/dev/null || true)
    else
        range="${remote_sha}..${local_sha}"
        commits=$(git log --format="%H" "${range}" 2>/dev/null || true)
    fi

    for commit in $commits; do
        commit_msg=$(git log --format="%B" -n 1 "$commit")

        if echo "$commit_msg" | grep -qiE "$AI_PATTERN"; then
            printf "${RED}❌ AI attribution found in commit ${commit:0:8}:${NC}\n"
            echo "$commit_msg" | grep -iE "$AI_PATTERN" | head -3
            VIOLATIONS=$((VIOLATIONS + 1))
        fi
    done
done

if [ $VIOLATIONS -gt 0 ]; then
    echo ""
    printf "${RED}╔════════════════════════════════════════════════════════════════╗${NC}\n"
    printf "${RED}║      PUSH BLOCKED - AI ATTRIBUTION IN COMMIT HISTORY          ║${NC}\n"
    printf "${RED}╚════════════════════════════════════════════════════════════════╝${NC}\n"
    echo ""
    printf "${YELLOW}Amend the offending commits to remove AI tool references.${NC}\n"
    echo ""
    exit 1
fi

printf "${GREEN}✓ No AI attribution found in commits being pushed${NC}\n"
exit 0
