#!/bin/bash
# Anton — Pre-commit Secret Detection Hook
# Prevents accidental commit of secrets, API keys, tokens, and private keys
# SECURITY: Blocks plaintext secrets from entering git history

set -e

# Colors for output
RED='\033[0;31m'
YELLOW='\033[1;33m'
GREEN='\033[0;32m'
NC='\033[0m' # No Color

# Override mechanism (use with caution, gets logged)
if [ -n "$SKIP_SECRET_CHECK" ]; then
    printf "${YELLOW}⚠️  SKIP_SECRET_CHECK enabled - bypassing secret detection${NC}\n"
    echo "$(date -u +%Y-%m-%dT%H:%M:%SZ) - Secret check skipped by $USER" >> .git/secret-check-overrides.log
    exit 0
fi

echo "🔒 Running secret detection on staged files..."

# Get list of staged files (excluding deletions)
STAGED_FILES=$(git diff --cached --name-only --diff-filter=d)

if [ -z "$STAGED_FILES" ]; then
    printf "${GREEN}✓ No files to check${NC}\n"
    exit 0
fi

# Track violations
VIOLATIONS=0
VIOLATION_DETAILS=""

# Function to check a file for secret patterns
check_file_for_secrets() {
    local file="$1"
    local violations=""

    # Skip binary files
    if file "$file" | grep -q "binary"; then
        return
    fi

    # Skip only the pre-commit hook itself (contains regex patterns that look like secrets)
    # Do NOT exclude the entire .husky/ directory — other hook scripts should still be scanned
    case "$file" in
        .husky/pre-commit) return ;;
    esac

    # Skip files larger than 1MB (likely not source code)
    if [ $(wc -c < "$file") -gt 1048576 ]; then
        return
    fi

    # Pattern 1: Common secret variable patterns
    violations=$(grep -nE '(API_KEY|SECRET|TOKEN|PASSWORD|PRIVATE_KEY|PRIV_KEY|ACCESS_KEY|PASSPHRASE)[[:space:]]*=[[:space:]]*['\''"]?[A-Za-z0-9+/=_-]{20,}' "$file" 2>/dev/null || true)
    if [ -n "$violations" ]; then
        printf "${RED}❌ Potential secret found in $file:${NC}\n"
        echo "$violations"
        VIOLATION_DETAILS="${VIOLATION_DETAILS}\n${file}:\n${violations}"
        VIOLATIONS=$((VIOLATIONS + 1))
    fi

    # Pattern 2: Age private key pattern (AGE-SECRET-KEY-)
    violations=$(grep -nF 'AGE-SECRET-KEY-' "$file" 2>/dev/null || true)
    if [ -n "$violations" ]; then
        printf "${RED}❌ Age private key found in $file:${NC}\n"
        echo "$violations"
        VIOLATION_DETAILS="${VIOLATION_DETAILS}\n${file}:\n${violations}"
        VIOLATIONS=$((VIOLATIONS + 1))
    fi

    # Pattern 3: Bearer tokens
    violations=$(grep -nE 'Bearer [A-Za-z0-9_-]{20,}' "$file" 2>/dev/null || true)
    if [ -n "$violations" ]; then
        printf "${RED}❌ Bearer token found in $file:${NC}\n"
        echo "$violations"
        VIOLATION_DETAILS="${VIOLATION_DETAILS}\n${file}:\n${violations}"
        VIOLATIONS=$((VIOLATIONS + 1))
    fi

    # Pattern 4: JWT tokens (three base64 segments separated by dots)
    violations=$(grep -nE 'eyJ[A-Za-z0-9_-]+\.eyJ[A-Za-z0-9_-]+\.[A-Za-z0-9_-]+' "$file" 2>/dev/null || true)
    if [ -n "$violations" ]; then
        printf "${RED}❌ JWT token found in $file:${NC}\n"
        echo "$violations"
        VIOLATION_DETAILS="${VIOLATION_DETAILS}\n${file}:\n${violations}"
        VIOLATIONS=$((VIOLATIONS + 1))
    fi

    # Pattern 5: Private key headers
    violations=$(grep -nE '(BEGIN (RSA |EC )?PRIVATE KEY|BEGIN OPENSSH PRIVATE KEY)' "$file" 2>/dev/null || true)
    if [ -n "$violations" ]; then
        printf "${RED}❌ Private key found in $file:${NC}\n"
        echo "$violations"
        VIOLATION_DETAILS="${VIOLATION_DETAILS}\n${file}:\n${violations}"
        VIOLATIONS=$((VIOLATIONS + 1))
    fi

    # Pattern 6: Slack tokens (xoxb-, xoxp-, xoxo-)
    violations=$(grep -nE 'xox[bpoas]-[0-9]+-[0-9A-Za-z-]+' "$file" 2>/dev/null || true)
    if [ -n "$violations" ]; then
        printf "${RED}❌ Slack token found in $file:${NC}\n"
        echo "$violations"
        VIOLATION_DETAILS="${VIOLATION_DETAILS}\n${file}:\n${violations}"
        VIOLATIONS=$((VIOLATIONS + 1))
    fi

    # Pattern 7: AWS keys
    violations=$(grep -nE '(AKIA[0-9A-Z]{16}|aws_secret_access_key)' "$file" 2>/dev/null || true)
    if [ -n "$violations" ]; then
        printf "${RED}❌ AWS credential found in $file:${NC}\n"
        echo "$violations"
        VIOLATION_DETAILS="${VIOLATION_DETAILS}\n${file}:\n${violations}"
        VIOLATIONS=$((VIOLATIONS + 1))
    fi

    # Pattern 8: GitHub tokens
    violations=$(grep -nE 'gh[pousr]_[A-Za-z0-9]{36,}' "$file" 2>/dev/null || true)
    if [ -n "$violations" ]; then
        printf "${RED}❌ GitHub token found in $file:${NC}\n"
        echo "$violations"
        VIOLATION_DETAILS="${VIOLATION_DETAILS}\n${file}:\n${violations}"
        VIOLATIONS=$((VIOLATIONS + 1))
    fi

    # Pattern 9: High-entropy base64 strings (potential keys)
    # Look for base64 strings of 40+ characters (likely secrets)
    violations=$(grep -nE '[A-Za-z0-9+/]{40,}={0,2}' "$file" 2>/dev/null | grep -vE '(test|example|mock|fixture|placeholder|dummy|sample)' || true)
    if [ -n "$violations" ]; then
        # Only flag if it looks like assignment (reduces false positives)
        violations=$(echo "$violations" | grep -E '=[[:space:]]*['\''"]?[A-Za-z0-9+/]{40,}' || true)
        if [ -n "$violations" ]; then
            printf "${YELLOW}⚠️  High-entropy string (potential secret) in $file:${NC}\n"
            echo "$violations" | head -5  # Limit output to first 5 matches
            VIOLATION_DETAILS="${VIOLATION_DETAILS}\n${file}:\n${violations}"
            VIOLATIONS=$((VIOLATIONS + 1))
        fi
    fi
}

# Function to check for forbidden file patterns
check_forbidden_files() {
    local forbidden_patterns=(
        '^\.env$'
        '^\.env\.local$'
        '^\.env\.development\.local$'
        '^\.env\.test\.local$'
        '^\.env\.production\.local$'
        '^secrets/.*\.json$'
        '^secrets/.*\.txt$'
        '\.key$'
        '\.pem$'
        '\.p12$'
        '\.pfx$'
        'keys\.txt$'
    )

    # Exception patterns (allowed)
    local allowed_patterns=(
        '\.encrypted$'
        '\.enc$'
        '\.example$'
    )

    for file in $STAGED_FILES; do
        # Check if file matches forbidden pattern
        for pattern in "${forbidden_patterns[@]}"; do
            if echo "$file" | grep -qE "$pattern"; then
                # Check if it's an allowed exception
                local is_allowed=false
                for allowed in "${allowed_patterns[@]}"; do
                    if echo "$file" | grep -qE "$allowed"; then
                        is_allowed=true
                        break
                    fi
                done

                if [ "$is_allowed" = false ]; then
                    printf "${RED}❌ Forbidden file pattern: $file${NC}\n"
                    echo "   This file type should not be committed (plaintext secrets)"
                    echo "   Use encrypted version (.encrypted or .enc) instead"
                    VIOLATION_DETAILS="${VIOLATION_DETAILS}\nForbidden file: ${file}"
                    VIOLATIONS=$((VIOLATIONS + 1))
                fi
            fi
        done
    done
}

# Run forbidden file check first
check_forbidden_files

# Check each staged file for secret patterns
for file in $STAGED_FILES; do
    if [ -f "$file" ]; then
        check_file_for_secrets "$file"
    fi
done

# Report results
if [ $VIOLATIONS -gt 0 ]; then
    echo ""
    printf "${RED}╔════════════════════════════════════════════════════════════════╗${NC}\n"
    printf "${RED}║           COMMIT BLOCKED - SECRETS DETECTED                    ║${NC}\n"
    printf "${RED}╚════════════════════════════════════════════════════════════════╝${NC}\n"
    echo ""
    printf "${YELLOW}Found $VIOLATIONS potential secret(s) in staged files.${NC}\n"
    echo ""
    echo "Please:"
    echo "  1. Remove the secrets from the files"
    echo "  2. Use SOPS-encrypted files (.env.encrypted, *.enc)"
    echo "  3. Use environment variables or secret management"
    echo ""
    echo "If this is a false positive (test fixture, example):"
    echo "  SKIP_SECRET_CHECK=1 git commit -m \"your message\""
    echo "  (This will be logged for audit purposes)"
    echo ""
    echo "For help with secret management, see:"
    echo "  - infra/sops-setup.md"
    echo "  - SECURITY.md"
    echo ""
    exit 1
else
    printf "${GREEN}✓ No secrets detected in staged files${NC}\n"
fi

# ── AI Attribution Check ──────────────────────────────────────────────────────
# Block commits that mention AI tools in staged file content
echo "🤖 Checking for AI attribution in staged files..."

AI_VIOLATIONS=0

for file in $STAGED_FILES; do
    # .claude/ is meta-tooling/documentation — exempt from AI attribution scan
    if echo "$file" | grep -qE '^\.claude/'; then
        continue
    fi
    if [ -f "$file" ]; then
        # Check file content for AI attribution patterns
        ai_hits=$(git diff --cached -- "$file" | grep '^+' | grep -v '^+++' | \
            grep -iE '(generated (by|with) (claude|copilot|chatgpt|gpt-4|openai)|co-authored-by:.*(claude|copilot|chatgpt)|written by ai|ai[- ]assisted|llm[- ]generated|🤖 generated)' \
            2>/dev/null || true)
        if [ -n "$ai_hits" ]; then
            printf "${RED}❌ AI attribution found in $file:${NC}\n"
            echo "$ai_hits" | head -5
            AI_VIOLATIONS=$((AI_VIOLATIONS + 1))
        fi
    fi
done

if [ $AI_VIOLATIONS -gt 0 ]; then
    echo ""
    printf "${RED}╔════════════════════════════════════════════════════════════════╗${NC}\n"
    printf "${RED}║       COMMIT BLOCKED - AI ATTRIBUTION DETECTED                ║${NC}\n"
    printf "${RED}╚════════════════════════════════════════════════════════════════╝${NC}\n"
    echo ""
    printf "${YELLOW}Remove all references to AI tools (Claude, Copilot, ChatGPT, etc.)${NC}\n"
    echo "Write commits and code as the developer."
    echo ""
    exit 1
fi

printf "${GREEN}✓ No AI attribution detected${NC}\n"

# ── Lint-staged ───────────────────────────────────────────────────────────────
echo "🔍 Running lint-staged..."
npx lint-staged
