#!/bin/bash
# Ahnton — Commit-msg Hook
# Enforces conventional commit format and blocks AI attribution

set -e

RED='\033[0;31m'
YELLOW='\033[1;33m'
GREEN='\033[0;32m'
NC='\033[0m'

COMMIT_MSG_FILE="$1"
COMMIT_MSG=$(cat "$COMMIT_MSG_FILE")

# -- AI Attribution Check --
if echo "$COMMIT_MSG" | grep -qiE '(generated (by|with) (claude|copilot|chatgpt|gpt-4|openai)|co-authored-by:.*(claude|copilot|chatgpt)|ai[- ]assisted|llm[- ]generated)'; then
    echo ""
    printf "${RED}COMMIT BLOCKED - AI ATTRIBUTION IN COMMIT MESSAGE${NC}\n"
    echo ""
    printf "${YELLOW}Remove all references to AI tools from the commit message.${NC}\n"
    echo "Write commit messages as the developer, not the tool."
    echo ""
    exit 1
fi

# -- Conventional Commits Format --
# Format: type(scope): description
CONVENTIONAL_PATTERN='^(feat|fix|docs|style|refactor|test|chore|security|infra|perf|revert|build|ci)(\([a-zA-Z0-9_/-]+\))?: .{1,100}'

# Skip merge commits, revert commits, and initial commits
if echo "$COMMIT_MSG" | grep -qE '^(Merge|Revert|Initial commit)'; then
    printf "${GREEN}Merge/revert commit — skipping conventional format check${NC}\n"
    exit 0
fi

# Skip fixup or squash commits
if echo "$COMMIT_MSG" | grep -qE '^(fixup!|squash!)'; then
    printf "${GREEN}Fixup/squash commit — skipping conventional format check${NC}\n"
    exit 0
fi

FIRST_LINE=$(echo "$COMMIT_MSG" | head -1)

if ! echo "$FIRST_LINE" | grep -qE "$CONVENTIONAL_PATTERN"; then
    echo ""
    printf "${RED}COMMIT BLOCKED - INVALID COMMIT MESSAGE FORMAT${NC}\n"
    echo ""
    printf "${YELLOW}Commit message must follow Conventional Commits format:${NC}\n"
    echo ""
    echo "  type(scope): short description"
    echo ""
    echo "Valid types:"
    echo "  feat      — new feature"
    echo "  fix       — bug fix"
    echo "  docs      — documentation only"
    echo "  refactor  — code change, no feature or fix"
    echo "  test      — adding or correcting tests"
    echo "  security  — security fix"
    echo "  infra     — infrastructure / DevOps"
    echo "  perf      — performance improvement"
    echo "  chore     — housekeeping, deps"
    echo "  ci        — CI/CD changes"
    echo ""
    printf "${YELLOW}Your message: ${FIRST_LINE}${NC}\n"
    echo ""
    exit 1
fi

printf "${GREEN}Commit message format valid${NC}\n"
exit 0
